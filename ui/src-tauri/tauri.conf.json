{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InFormal",
  "version": "0.1.0",
  "identifier": "dev.informal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "InFormal", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app"],
    "icon": ["icons/icon.png"]
  }
}
