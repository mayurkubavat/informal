# Build output
/target/
**/target/

# Shell work directories (FPV session output: btor2, vcd, logs)
/informal_work/
*_work/

# Benchmark data and results stay local (multi-GB; see bench/README.md)
/bench/hwmcc*/
/bench/hwmcc25
/bench/hwmcc24
/bench/bin/
/bench/.work/
/bench/runs*.jsonl
/bench/seeds/
/bench/store*/
/bench/measure/
*.log

# Research notes, reports and review notes stay local (not for the repo)
/research/
/docs/review/

# Tool droppings
abc.history
yosys.history
/*.vcd
/*.fst

# Secrets and local config overrides
.env
.env.*
*.local.toml

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp
*~

# Papers are copyrighted; keep PDFs local
/refs/*.pdf

# AI assistant and agent state (never part of the repo)
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
.cursor/
.aider*
.codex/
.gemini/
.continue/

# Keys and credentials
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
.netrc
.npmrc
.pypirc

# Python droppings (svlang bindings, scripts)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Waveforms and local scratch anywhere, not only at the root
*.vcd
*.fst
*.fsdb
/scratch/
# ...except tracked test fixtures
!ui/tests/fixtures/*.vcd
!tests/**/*.vcd

# Local third-party tool builds (scripts/tools.sh)
/tools/

# Built documentation site (mkdocs build)
/site/
