upf_version 2.1
set_design_top f6_ret_bugs

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VSS
create_supply_net  VDD_SW
create_supply_net  VDD_RET
create_supply_net  VDD_BKP
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON -function {power VDD_AON} -function {ground VSS}
create_supply_set SS_SW  -function {power VDD_SW}  -function {ground VSS}
create_supply_set SS_RET -function {power VDD_RET} -function {ground VSS}
create_supply_set SS_BKP -function {power VDD_BKP} -function {ground VSS}

create_power_domain PD_TOP -include_scope -supply {primary SS_AON}
create_power_domain PD_SW  -elements {u_src} -supply {primary SS_SW}
create_power_domain PD_RET -elements {u_ret} -supply {primary SS_RET}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_SW \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_en} -simstate CORRUPT}
add_power_state SS_RET \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_en} -simstate CORRUPT}
# Bug 1: retention backup supply SS_BKP can also turn OFF when PD_RET is OFF -> RET_BACKUP_OFF
add_power_state SS_BKP \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {backup_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!backup_en} -simstate CORRUPT}

set_retention ret_cfg -domain PD_RET -retention_supply_set SS_BKP \
    -save_signal {ret_save high} -restore_signal {ret_restore high}
set_retention_elements ret_elems -domain PD_RET -elements {u_ret/q}

# Isolate u_src/data_o only, leaving sw_rst_n (async reset to u_ret) unisolated -> RET_ASYNC_RST_UNISOLATED
set_isolation iso_data_only -domain PD_SW -elements {u_src/data_o} -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_en -isolation_sense high -location parent
set_isolation iso_ret -domain PD_RET -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_en -isolation_sense high -location parent

set_port_attributes -ports {clk rst_n pwr_en backup_en iso_en ret_save ret_restore gen_rst ret_q} \
    -driver_supply SS_AON -receiver_supply SS_AON
