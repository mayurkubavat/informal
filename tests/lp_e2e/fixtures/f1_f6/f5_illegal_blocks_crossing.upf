upf_version 2.1
set_design_top f5_illegal_blocks_crossing

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VSS
create_supply_net  VDD_A
create_supply_net  VDD_B
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON -function {power VDD_AON} -function {ground VSS}
create_supply_set SS_A   -function {power VDD_A}   -function {ground VSS}
create_supply_set SS_B   -function {power VDD_B}   -function {ground VSS}

create_power_domain PD_TOP -include_scope -supply {primary SS_AON}
create_power_domain PD_A   -elements {u_a} -supply {primary SS_A}
create_power_domain PD_B   -elements {u_b} -supply {primary SS_B}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_A \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {en_a}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!en_a} -simstate CORRUPT}
add_power_state SS_B \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {en_b}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!en_b} -simstate CORRUPT}

# Mark PD_A=OFF while PD_B=ON illegal so u_a -> u_b needs no isolation
add_power_state SS_A -state {ILL_A_OFF_B_ON -logic_expr {!en_a && en_b} -illegal}

# Isolate only u_b -> PD_TOP when PD_B sleeps
set_isolation iso_b -domain PD_B -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal en_b -isolation_sense low -location parent
