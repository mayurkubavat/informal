upf_version 2.1
set_design_top f6_iso_bugs

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VSS
create_supply_net  VDD_A
create_supply_net  VDD_B
create_supply_net  VDD_C
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON -function {power VDD_AON} -function {ground VSS}
create_supply_set SS_A   -function {power VDD_A}   -function {ground VSS}
create_supply_set SS_B   -function {power VDD_B}   -function {ground VSS}
create_supply_set SS_C   -function {power VDD_C}   -function {ground VSS}

create_power_domain PD_TOP -include_scope -supply {primary SS_AON}
create_power_domain PD_A   -elements {u_dom_a} -supply {primary SS_A}
create_power_domain PD_B   -elements {u_dom_b} -supply {primary SS_B}
create_power_domain PD_C   -elements {u_dom_c} -supply {primary SS_C}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_A \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_a_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_a_en} -simstate CORRUPT}
add_power_state SS_B \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_b_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_b_en} -simstate CORRUPT}
add_power_state SS_C \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_b_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_b_en} -simstate CORRUPT}

# Bug 1: PD_A has no isolation at all -> ISO_MISSING
# Bug 2: PD_B uses switchable control signal u_dom_a/ctrl_out -> ISO_CTRL_UNPOWERED
set_isolation iso_b -domain PD_B -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal u_dom_a/ctrl_out -isolation_sense high -location parent

# Bug 3: PD_C places isolation in -location self using SS_C (which turns OFF!) -> ISO_LOCATION_INVALID
set_isolation iso_c -domain PD_C -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_C -isolation_signal aon_iso_en -isolation_sense high -location self

set_port_attributes -ports {clk rst_n pwr_a_en pwr_b_en aon_iso_en din out_missing out_unpowered_ctrl out_bad_loc} \
    -driver_supply SS_AON -receiver_supply SS_AON
