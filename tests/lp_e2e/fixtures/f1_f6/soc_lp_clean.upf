upf_version 2.1
set_design_top soc_lp_clean

create_supply_port VDD_AON -direction in
create_supply_port VDD_IO  -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VDD_IO
create_supply_net  VSS
create_supply_net  VDD_CORE
create_supply_net  VDD_MID
create_supply_net  VDD_RET

connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VDD_IO  -ports VDD_IO
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON  -function {power VDD_AON}  -function {ground VSS}
create_supply_set SS_CORE -function {power VDD_CORE} -function {ground VSS}
create_supply_set SS_MID  -function {power VDD_MID}  -function {ground VSS}
create_supply_set SS_RET  -function {power VDD_RET}  -function {ground VSS}
create_supply_set SS_IO   -function {power VDD_IO}   -function {ground VSS}

create_power_domain PD_TOP  -include_scope -supply {primary SS_AON}
create_power_domain PD_CORE -elements {u_core} -supply {primary SS_CORE}
create_power_domain PD_MID  -elements {u_mid}  -supply {primary SS_MID}
create_power_domain PD_RET  -elements {u_ret}  -supply {primary SS_RET}
create_power_domain PD_IO   -elements {u_io}   -supply {primary SS_IO}

create_power_switch PSW_CORE -domain PD_CORE \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_CORE} \
    -control_port {ctrl u_pmu/pwr_core_en} -ack_port {ack pwr_ack} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

create_power_switch PSW_MID -domain PD_MID \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_MID} \
    -control_port {ctrl u_pmu/pwr_core_en} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

create_power_switch PSW_RET -domain PD_RET \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_RET} \
    -control_port {ctrl u_pmu/pwr_ret_en} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_IO  -state {IO_ON  -supply_expr {power == {FULL_ON 1.10} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_CORE \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {u_pmu/pwr_core_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!u_pmu/pwr_core_en} -simstate CORRUPT}
add_power_state SS_MID \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {u_pmu/pwr_core_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!u_pmu/pwr_core_en} -simstate CORRUPT}
add_power_state SS_RET \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {u_pmu/pwr_ret_en}   -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!u_pmu/pwr_ret_en}  -simstate CORRUPT}

set_isolation iso_core -domain PD_CORE -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal u_pmu/iso_core_en -isolation_sense high -location parent
set_isolation iso_ret -domain PD_RET -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal u_pmu/iso_ret_en -isolation_sense high -location parent

set_level_shifter ls_ret -domain PD_RET -applies_to outputs -rule low_to_high -location parent
set_level_shifter ls_io_clk_rst -domain PD_IO -applies_to inputs -elements {u_io/clk u_io/rst_n} -rule low_to_high -location self

set_retention ret_island_cfg -domain PD_RET -retention_supply_set SS_AON \
    -save_signal {u_pmu/ret_save high} -restore_signal {u_pmu/ret_restore high}
set_retention_elements ret_island_elems -domain PD_RET -elements {u_ret/q}

set_port_attributes -ports {clk rst_n sleep_core sleep_ret din pwr_ack} -driver_supply SS_AON -receiver_supply SS_AON
set_port_attributes -ports {io_dout} -driver_supply SS_IO -receiver_supply SS_IO
