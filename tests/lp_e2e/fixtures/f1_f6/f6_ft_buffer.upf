upf_version 2.1
set_design_top f6_ft_buffer

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VSS
create_supply_net  VDD_SRC
create_supply_net  VDD_MID
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON -function {power VDD_AON} -function {ground VSS}
create_supply_set SS_SRC -function {power VDD_SRC} -function {ground VSS}
create_supply_set SS_MID -function {power VDD_MID} -function {ground VSS}

create_power_domain PD_TOP -include_scope -supply {primary SS_AON}
create_power_domain PD_SRC -elements {u_src} -supply {primary SS_SRC}
create_power_domain PD_MID -elements {u_mid} -supply {primary SS_MID}
create_power_domain PD_DST -elements {u_dst} -supply {primary SS_AON}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_SRC \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_en} -simstate CORRUPT}
add_power_state SS_MID \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_en} -simstate CORRUPT}

set_isolation iso_src -domain PD_SRC -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_en -isolation_sense high -location parent
# Note: PD_MID buffers the feedthrough on switchable supply SS_MID -> triggers ISO_FEEDTHROUGH_BUFFER / AON_NON_AON_BUFFER
set_port_attributes -ports {clk rst_n pwr_en iso_en din dout} -driver_supply SS_AON -receiver_supply SS_AON
