upf_version 2.1
set_design_top soc_basic

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VSS
create_supply_net  VDD_CORE
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON  -function {power VDD_AON}  -function {ground VSS}
create_supply_set SS_CORE -function {power VDD_CORE} -function {ground VSS}

create_power_domain PD_TOP  -include_scope -supply {primary SS_AON}
create_power_domain PD_CORE -elements {u_core u_sub} -supply {primary SS_CORE}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_CORE \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {u_pmu/pwr_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!u_pmu/pwr_en} -simstate CORRUPT}

# Intentional mismatch: clamp_value flipped from 0 to 1
set_isolation iso_core -domain PD_CORE -applies_to outputs -clamp_value 1 \
    -isolation_supply_set SS_AON -isolation_signal u_pmu/iso_en -isolation_sense high -location parent
set_retention ret_core -domain PD_CORE -retention_supply_set SS_AON \
    -save_signal {u_pmu/ret_save high} -restore_signal {u_pmu/ret_restore high}
