upf_version 2.1
set_design_top f6_iso_pol_inv3

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VSS
create_supply_net  VDD_CORE
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON  -function {power VDD_AON}  -function {ground VSS}
create_supply_set SS_CORE -function {power VDD_CORE} -function {ground VSS}

create_power_domain PD_TOP  -include_scope -supply {primary SS_AON}
create_power_domain PD_CORE -elements {u_core} -supply {primary SS_CORE}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_CORE \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_en}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_en} -simstate CORRUPT}

# Bug: iso_ctrl_inv is driven by 3-inverter odd chain from aon_iso_en while -isolation_sense is high
set_isolation iso_pol -domain PD_CORE -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_ctrl_inv -isolation_sense high -location parent

set_port_attributes -ports {clk rst_n pwr_en aon_iso_en din dout} -driver_supply SS_AON -receiver_supply SS_AON
