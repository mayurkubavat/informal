upf_version 3.1
set_design_top soc_basic

proc mk_aon_supply {name} {
    create_supply_port $name -direction in
    create_supply_net  $name
    connect_supply_net $name -ports $name
}

foreach p {VDD_AON VSS} {
    mk_aon_supply $p
}

create_supply_net VDD_CORE
create_supply_net VDD_SUB

create_supply_set SS_AON  -function {power VDD_AON}  -function {ground VSS}
create_supply_set SS_CORE -function {power VDD_CORE} -function {ground VSS}
create_supply_set SS_SUB  -function {power VDD_SUB}  -function {ground VSS}

create_power_domain PD_TOP  -include_scope -supply {primary SS_AON}
create_power_domain PD_CORE -elements {u_core} -supply {primary SS_CORE}
create_power_domain PD_SUB  -elements {u_sub}  -supply {primary SS_SUB}

set_equivalent -sets {SS_CORE SS_SUB}

create_power_switch PSW_CORE -domain PD_CORE \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_CORE} \
    -control_port {ctrl u_pmu/pwr_en} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

create_power_switch PSW_SUB -domain PD_SUB \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_SUB} \
    -control_port {ctrl u_pmu/pwr_en} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
foreach ss {SS_CORE SS_SUB} {
    add_power_state $ss \
        -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {u_pmu/pwr_en}  -simstate NORMAL} \
        -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!u_pmu/pwr_en} -simstate CORRUPT}
}

set_isolation iso_core -domain PD_CORE -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal u_pmu/iso_en -isolation_sense high -location parent \
    -name_prefix ISO_ -name_suffix _CELL
set_isolation iso_sub -domain PD_SUB -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal u_pmu/iso_en -isolation_sense high -location parent

set_retention ret_core -domain PD_CORE -retention_supply_set SS_AON \
    -save_signal {u_pmu/ret_save high} -restore_signal {u_pmu/ret_restore high}
set_retention_elements ret_elems_core -domain PD_CORE -elements {u_core/dout}

set_port_attributes -ports {din dout sub_dout} -driver_supply SS_AON -receiver_supply SS_AON
