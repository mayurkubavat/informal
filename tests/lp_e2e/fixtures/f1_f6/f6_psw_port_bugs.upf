upf_version 2.1
set_design_top f6_psw_port_bugs

create_supply_port VDD_AON -direction in
create_supply_port VDD_IO  -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VDD_IO
create_supply_net  VSS
create_supply_net  VDD_CORE
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VDD_IO  -ports VDD_IO
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON  -function {power VDD_AON}  -function {ground VSS}
create_supply_set SS_IO   -function {power VDD_IO}   -function {ground VSS}
create_supply_set SS_CORE -function {power VDD_CORE} -function {ground VSS}

create_power_domain PD_TOP  -include_scope -supply {primary SS_AON}
create_power_domain PD_CORE -elements {u_core} -supply {primary SS_CORE}

# Bug 1: PSW control port driven by u_core/self_ctrl_out inside switchable PD_CORE -> PSW_CTRL_UNPOWERED
create_power_switch PSW_CORE -domain PD_CORE \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_CORE} \
    -control_port {ctrl u_core/self_ctrl_out} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_IO  -state {IO_ON  -supply_expr {power == {FULL_ON 1.10} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_CORE \
    -state {ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {u_core/self_ctrl_out}  -simstate NORMAL} \
    -state {OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!u_core/self_ctrl_out} -simstate CORRUPT}

set_isolation iso_core -domain PD_CORE -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_en -isolation_sense high -location parent

# Bug 2: top-level port io_unattr_out lacks set_port_attributes in multi-supply design -> PORT_ATTR_MISSING
set_port_attributes -ports {clk rst_n ctrl_in iso_en din} -driver_supply SS_AON -receiver_supply SS_AON
