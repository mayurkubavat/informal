upf_version 1.0
set_design_top mig_soc

create_supply_port VDD_AON  -direction in
create_supply_port VDD_HIGH -direction in
create_supply_port VSS      -direction in

create_supply_net VDD_AON
create_supply_net VDD_HIGH
create_supply_net VDD_CPU_SW
create_supply_net VDD_DSP_SW
create_supply_net VSS

connect_supply_net VDD_AON  -ports VDD_AON
connect_supply_net VDD_HIGH -ports VDD_HIGH
connect_supply_net VSS      -ports VSS

create_power_domain PD_TOP -include_scope
create_power_domain PD_CPU -elements {u_cpu}
create_power_domain PD_DSP -elements {u_dsp}
create_power_domain PD_MEM -elements {u_mem}

set_domain_supply_net PD_TOP -primary_power_net VDD_AON    -primary_ground_net VSS
set_domain_supply_net PD_CPU -primary_power_net VDD_CPU_SW -primary_ground_net VSS
set_domain_supply_net PD_DSP -primary_power_net VDD_DSP_SW -primary_ground_net VSS
set_domain_supply_net PD_MEM -primary_power_net VDD_HIGH   -primary_ground_net VSS

create_power_switch PSW_CPU -domain PD_CPU \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_CPU_SW} \
    -control_port {ctrl pwr_cpu} -ack_port {ack ack_cpu} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

create_power_switch PSW_DSP -domain PD_DSP \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_DSP_SW} \
    -control_port {ctrl pwr_dsp} -ack_port {ack ack_dsp} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

add_port_state VDD_AON    -state {AON_ON  0.90}
add_port_state VDD_HIGH   -state {HIGH_ON 1.10}
add_port_state VSS        -state {VSS_ON  0.00}
add_port_state VDD_CPU_SW -state {CPU_ON  0.90} -state {CPU_OFF off}
add_port_state VDD_DSP_SW -state {DSP_ON  0.90} -state {DSP_OFF off}

create_pst pst_mig -supplies {VDD_AON VDD_HIGH VSS VDD_CPU_SW VDD_DSP_SW}
add_pst_state ALL_ON   -pst pst_mig -state {AON_ON HIGH_ON VSS_ON CPU_ON  DSP_ON}
add_pst_state CPU_SLP  -pst pst_mig -state {AON_ON HIGH_ON VSS_ON CPU_OFF DSP_ON}
add_pst_state DSP_SLP  -pst pst_mig -state {AON_ON HIGH_ON VSS_ON CPU_ON  DSP_OFF}
add_pst_state BOTH_SLP -pst pst_mig -state {AON_ON HIGH_ON VSS_ON CPU_OFF DSP_OFF}

set_isolation iso_cpu -domain PD_CPU -applies_to outputs -clamp_value 0 \
    -isolation_power_net VDD_AON -isolation_ground_net VSS
set_isolation_control iso_cpu -domain PD_CPU -isolation_signal iso_cpu -isolation_sense high -location parent

set_isolation iso_dsp -domain PD_DSP -applies_to outputs -clamp_value 0 \
    -isolation_power_net VDD_AON -isolation_ground_net VSS
set_isolation_control iso_dsp -domain PD_DSP -isolation_signal iso_dsp -isolation_sense high -location parent

set_retention ret_cpu -domain PD_CPU -retention_power_net VDD_AON -retention_ground_net VSS
set_retention_control ret_cpu -domain PD_CPU -save_signal {ret_save high} -restore_signal {ret_restore high}
set_retention_elements ret_cpu_el -domain PD_CPU -elements {u_cpu/q_cpu}

set_level_shifter ls_dsp_to_mem -domain PD_MEM -applies_to inputs -rule low_to_high -location self
set_level_shifter ls_mem_to_top -domain PD_MEM -applies_to outputs -rule high_to_low -location self
