upf_version 2.1
set_design_top mobile_soc_top

create_supply_port VDD_AON -direction in
create_supply_port VDD_IO  -direction in
create_supply_port VSS     -direction in

create_supply_net VDD_AON
create_supply_net VDD_CPU_SW
create_supply_net VDD_SRAM_SW
create_supply_net VDD_IO
create_supply_net VSS

connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VDD_IO  -ports VDD_IO
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON  -function {power VDD_AON}     -function {ground VSS}
create_supply_set SS_CPU  -function {power VDD_CPU_SW}  -function {ground VSS}
create_supply_set SS_SRAM -function {power VDD_SRAM_SW} -function {ground VSS}
create_supply_set SS_IO   -function {power VDD_IO}      -function {ground VSS}

create_power_domain PD_TOP  -include_scope       -supply {primary SS_AON}
create_power_domain PD_CPU  -elements {u_cpu u_ft} -supply {primary SS_CPU}
create_power_domain PD_SRAM -elements {u_sram}   -supply {primary SS_SRAM}
create_power_domain PD_IO   -elements {u_io}     -supply {primary SS_IO}

create_power_switch PSW_CPU -domain PD_CPU \
    -input_supply_port {in VDD_AON} \
    -output_supply_port {out VDD_CPU_SW} \
    -control_port {ctrl psw_cpu} \
    -ack_port {ack psw_cpu_ack} \
    -on_state {ON_ST in {ctrl}} \
    -off_state {OFF_ST {!ctrl}}

create_power_switch PSW_SRAM -domain PD_SRAM \
    -input_supply_port {in VDD_AON} \
    -output_supply_port {out VDD_SRAM_SW} \
    -control_port {ctrl psw_sram} \
    -ack_port {ack psw_sram_ack} \
    -on_state {ON_ST in {ctrl}} \
    -off_state {OFF_ST {!ctrl}}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_IO  -state {IO_ON  -supply_expr {power == {FULL_ON 1.80} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_CPU \
    -state {CPU_ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {psw_cpu}  -simstate NORMAL} \
    -state {CPU_OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!psw_cpu} -simstate CORRUPT}
add_power_state SS_SRAM \
    -state {SRAM_ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {psw_sram && !ret_save} -simstate NORMAL} \
    -state {SRAM_RET -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {psw_sram && ret_save}  -simstate CORRUPT_ON_ACTIVITY} \
    -state {SRAM_OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!psw_sram}             -simstate CORRUPT}

set_isolation iso_cpu -domain PD_CPU -applies_to outputs \
    -exclude_elements {u_cpu/debug_bus} -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_cpu -isolation_sense high -location parent

set_isolation iso_sram -domain PD_SRAM -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal iso_sram -isolation_sense high -location parent

set_level_shifter ls_cpu_to_io -domain PD_IO -applies_to inputs -elements {u_io/from_cpu} -rule low_to_high -location self
set_level_shifter ls_aon_to_io -domain PD_IO -applies_to inputs -elements {u_io/from_aon u_io/clk u_io/rst_n} -rule low_to_high -location self
set_level_shifter ls_io_to_aon -domain PD_IO -applies_to outputs -elements {u_io/io_to_aon} -rule high_to_low -location self

set_retention ret_sram -domain PD_SRAM -retention_supply_set SS_AON \
    -save_signal {ret_save high} -restore_signal {ret_restore high}
set_retention_elements ret_sram_el -domain PD_SRAM -elements {u_sram/ret_state}

set_port_attributes -ports {clk rst_n sleep_req sram_we sram_addr din cpu_bus_o dbg_o sram_o ft_o io_aon_o psw_cpu_ack psw_sram_ack} \
    -driver_supply SS_AON -receiver_supply SS_AON
set_port_attributes -ports {pad_out} -driver_supply SS_IO -receiver_supply SS_IO
