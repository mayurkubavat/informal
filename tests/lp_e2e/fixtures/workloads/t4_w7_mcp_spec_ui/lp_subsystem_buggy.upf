upf_version 2.1
set_design_top lp_subsystem

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in
create_supply_net  VDD_AON
create_supply_net  VDD_ENG_SW
create_supply_net  VSS
connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON -function {power VDD_AON}    -function {ground VSS}
create_supply_set SS_ENG -function {power VDD_ENG_SW} -function {ground VSS}

create_power_domain PD_TOP -include_scope    -supply {primary SS_AON}
create_power_domain PD_ENG -elements {u_eng} -supply {primary SS_ENG}

create_power_switch PSW_ENG -domain PD_ENG \
    -input_supply_port {in VDD_AON} -output_supply_port {out VDD_ENG_SW} \
    -control_port {ctrl pwr_en} -ack_port {ack pwr_ack} \
    -on_state {ON_ST in {ctrl}} -off_state {OFF_ST {!ctrl}}

add_power_state SS_AON -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}
add_power_state SS_ENG \
    -state {ENG_ON  -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {pwr_en}  -simstate NORMAL} \
    -state {ENG_OFF -supply_expr {power == OFF            && ground == {FULL_ON 0.0}} -logic_expr {!pwr_en} -simstate CORRUPT}
