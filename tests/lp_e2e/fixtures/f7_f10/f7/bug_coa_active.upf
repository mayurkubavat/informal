upf_version 2.1
set_design_top bug_coa_active

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in

create_supply_net VDD_AON
create_supply_net VDD_COA
create_supply_net VSS

connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON -function {power VDD_AON} -function {ground VSS}
create_supply_set SS_COA -function {power VDD_COA} -function {ground VSS}

create_power_domain PD_TOP -include_scope   -supply {primary SS_AON}
create_power_domain PD_COA -elements {u_coa} -supply {primary SS_COA}

add_power_state SS_AON \
    -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}

add_power_state SS_COA \
    -state {ON        -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {!coa_mode} -simstate NORMAL} \
    -state {GATE_IDLE -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {coa_mode}  -simstate CORRUPT_ON_ACTIVITY}
