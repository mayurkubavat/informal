upf_version 2.1
set_design_top simstate_coa_clean

create_supply_port VDD_AON -direction in
create_supply_port VSS     -direction in

create_supply_net VDD_AON
create_supply_net VDD_IO
create_supply_net VDD_SRAM
create_supply_net VSS

connect_supply_net VDD_AON -ports VDD_AON
connect_supply_net VSS     -ports VSS

create_supply_set SS_AON  -function {power VDD_AON}  -function {ground VSS}
create_supply_set SS_IO   -function {power VDD_IO}   -function {ground VSS}
create_supply_set SS_SRAM -function {power VDD_SRAM} -function {ground VSS}

create_power_domain PD_TOP  -include_scope    -supply {primary SS_AON}
create_power_domain PD_IO   -elements {u_io}   -supply {primary SS_IO}
create_power_domain PD_SRAM -elements {u_sram} -supply {primary SS_SRAM}

add_power_state SS_AON \
    -state {AON_ON -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -simstate NORMAL}

add_power_state SS_IO \
    -state {ON        -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {!coa_mode} -simstate NORMAL} \
    -state {GATE_IDLE -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {coa_mode}  -simstate CORRUPT_ON_ACTIVITY}

add_power_state SS_SRAM \
    -state {ON          -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {!csoa_mode} -simstate NORMAL} \
    -state {LIGHT_SLEEP -supply_expr {power == {FULL_ON 0.90} && ground == {FULL_ON 0.0}} -logic_expr {csoa_mode}  -simstate CORRUPT_STATE_ON_ACTIVITY}

set_isolation iso_io -domain PD_IO -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal coa_mode -isolation_sense high -location parent

set_isolation iso_sram -domain PD_SRAM -applies_to outputs -clamp_value 0 \
    -isolation_supply_set SS_AON -isolation_signal csoa_mode -isolation_sense high -location parent
